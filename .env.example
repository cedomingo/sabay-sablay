# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- OCR microservice (FastAPI on Render) ---
OCR_SERVICE_URL=https://your-ocr-service.onrender.com
OCR_SERVICE_KEY=

# --- CRS-Monitor (Turso/libSQL, same account/different project, server-only) ---
CRS_MONITOR_TURSO_URL=
CRS_MONITOR_TURSO_AUTH_TOKEN=

# --- Map tab tiles (see lib/map/tileConfig.ts for the §C decision) ---
# Get a free key at https://cloud.maptiler.com. Without this, the Map tab
# falls back to raw OSM tiles, which is fine for local dev but must NOT be
# used in production (OSM's usage policy doesn't allow it at app scale).
NEXT_PUBLIC_MAPTILER_KEY=
